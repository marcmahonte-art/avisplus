# =============================================================================
# AVIS+ — Variables d'environnement
# Copiez ce fichier en `.env.local` puis renseignez les valeurs réelles.
# =============================================================================

# --- Identité publique du site -------------------------------------------------
# Domaine utilisé pour construire les URL publiques et les QR Codes.
NEXT_PUBLIC_SITE_URL=https://avisplus.bf

# Coordonnées affichées sur le site et les pages digitales.
NEXT_PUBLIC_PHONE="+226 70 00 00 00"
NEXT_PUBLIC_WHATSAPP="+226 70 00 00 00"
NEXT_PUBLIC_EMAIL=contact@avisplus.bf

# --- Back-office (V1 provisoire) ----------------------------------------------
# ⚠️ Ces identifiants seront remplacés par Supabase Auth (cahier des charges §33).
ADMIN_EMAIL=admin@avisplus.bf
ADMIN_PASSWORD=avisplus2026
# Secret de signature de la session administrateur.
ADMIN_SESSION_SECRET=changez-cette-valeur-avant-toute-mise-en-production

# --- Supabase (à activer lors du branchement de la base) -----------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
